{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/path_rules.py",
            "timeout": 20,
            "statusMessage": "path-rules hook"
          }
        ]
      }
    ]
  }
}
